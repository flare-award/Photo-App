<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Serendip" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/serendip_background</item>
        <item name="android:colorBackground">@color/serendip_background</item>
        <item name="android:colorPrimary">@color/serendip_gold</item>
        <item name="android:colorAccent">@color/serendip_gold</item>
        <item name="android:textColorPrimary">@color/serendip_on_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <!-- System splash screen (Android 12+): dark background, gold mark. -->
        <item name="android:windowSplashScreenBackground">@color/serendip_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/serendip_background</item>
    </style>
</resources>
