<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The app is dark-only by design: there is no light variant and no theme switch.
        Window-level attributes keep the first frame dark before Compose draws.
    -->
    <style name="Theme.Serendip" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/serendip_background</item>
        <item name="android:colorBackground">@color/serendip_background</item>
        <item name="android:colorPrimary">@color/serendip_gold</item>
        <item name="android:colorAccent">@color/serendip_gold</item>
        <item name="android:textColorPrimary">@color/serendip_on_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
